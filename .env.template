# Bibo — sekrety. Skopiuj do .env w katalogu profilu i uzupełnij
# (albo po prostu uruchom ./install.sh, który zrobi to za Ciebie).

# Token bota od @BotFather
TELEGRAM_BOT_TOKEN=

# Twoje Telegram user ID (od @userinfobot) — tylko Ty możesz pisać z Bibo
TELEGRAM_ALLOWED_USERS=

# Gdzie Bibo pisze sam z siebie — zwykle to samo ID co wyżej
TELEGRAM_HOME_CHANNEL=

# Klucz API Anthropic (zalecane — płacisz za tokeny, bez niespodzianek z limitem)
ANTHROPIC_API_KEY=
